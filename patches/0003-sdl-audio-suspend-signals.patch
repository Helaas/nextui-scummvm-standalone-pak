+// Handheld builds: with SCUMMVM_AUDIO_SIGNALS set, SIGUSR1 closes the audio
+// device and SIGUSR2 reopens it. A power helper uses this around a system
+// suspend on firmwares whose ALSA driver does not recover an open PCM (H700).
+// The handler only records the request; pollEvent() acts on it.
+static volatile sig_atomic_t g_audioSignalRequest = 0;
+
+static void handleAudioSignal(int sig) {
+	g_audioSignalRequest = (sig == SIGUSR1) ? 1 : 2;
+}
