+
+Common::KeymapperDefaultBindings *OSystem_POSIX::getKeymapperDefaultBindings() {
+	// Default bindings for handheld builds, read from the file named by
+	// SCUMMVM_KEYMAP_DEFAULTS. Each line is "<keymap> <action> [<input>...]";
+	// an action listed without inputs is unbound by default. Mappings saved
+	// from the keymapper GUI still take precedence.
+	const char *path = getenv("SCUMMVM_KEYMAP_DEFAULTS");
+	if (!path || !*path)
+		return nullptr;
+
+	Common::FSNode node(Common::Path(path, Common::Path::kNativeSeparator));
+	Common::SeekableReadStream *stream = node.createReadStream();
+	if (!stream) {
+		warning("Cannot read keymap defaults from '%s'", path);
+		return nullptr;
+	}
+
+	// The keymapper owns the result and deletes it when inputs are re-registered.
+	Common::KeymapperDefaultBindings *bindings = new Common::KeymapperDefaultBindings();
+	while (!stream->eos() && !stream->err()) {
+		Common::String line = stream->readLine();
+		line.trim();
+		if (line.empty() || line.firstChar() == '#')
+			continue;
+
+		Common::StringTokenizer tokens(line, " \t");
+		Common::String keymapId = tokens.nextToken();
+		Common::String actionId = tokens.nextToken();
+		if (actionId.empty()) {
+			warning("Ignoring malformed keymap default '%s'", line.c_str());
+			continue;
+		}
+
+		bindings->setDefaultBinding(keymapId, actionId, "");
+		while (!tokens.empty()) {
+			Common::String input = tokens.nextToken();
+			if (!input.empty())
+				bindings->addDefaultBinding(keymapId, actionId, input);
+		}
+	}
+	delete stream;
+
+	return bindings;
+}
